# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Web client. These are intentionally public client values for Next.js.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never ship this in Android or web clients.
SUPABASE_SERVICE_ROLE_KEY=

# API
API_BASE_URL=

# Storage
DOCUMENT_STORAGE_BUCKET=documents

# Local development
NODE_ENV=development
